RewriteEngine On
RewriteBase /

# Tenta abrir o arquivo com a extensão .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# ── Compressão Gzip/Deflate ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Headers de Segurança e Controle de Cache ─────────────────────────────
<IfModule mod_headers.c>
    # Impedir MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Impedir clickjacking (iframe embedding)
    Header always set X-Frame-Options "DENY"
    # Política de Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Proteção contra XSS (navegadores antigos)
    Header always set X-XSS-Protection "1; mode=block"
    # Desabilitar câmera, microfone, geolocalização
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Cache de segurança para conteúdo dinâmico JSON
    Header always set Cache-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#application/json#"

    <FilesMatch "\.(html|htm)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    <FilesMatch "\.(png|jpg|jpeg|webp|gif|ico|svg|woff|woff2)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
